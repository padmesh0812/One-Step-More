# Server Port (Render / Railway assign PORT automatically)
PORT=5000

# Razorpay Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Email Delivery via Resend (HTTPS Port 443 - Recommended for Render Cloud)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=1 Step More <onboarding@resend.dev>

# Optional Fallback SMTP
SMTP_USER=onestepmore04@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
