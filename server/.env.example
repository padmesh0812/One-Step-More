# Server Port (Render / Railway assign PORT automatically)
PORT=5000

# Razorpay Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Email Alerts Configuration (Optional - for instant Gmail alerts on enquiry/payment)
NOTIFICATION_EMAIL=onestepmore04@gmail.com
SMTP_USER=onestepmore04@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
